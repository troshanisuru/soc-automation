{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRoleTags",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::908157891283:role/SOC-Middleware-Role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::908157891283:role/SOC-Middleware-Role",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "soc-automation"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "Null": {
          "aws:RequestTag/Project": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:UpdateAssumeRolePolicy",
      "Resource": "arn:aws:iam::908157891283:role/SOC-Middleware-Role",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "soc-automation"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::908157891283:role/SOC-Middleware-Role",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "soc-automation",
          "iam:PolicyARN": "arn:aws:iam::908157891283:policy/SOC-Middleware-WebSG-Policy"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:ListPolicyTags",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": "arn:aws:iam::908157891283:policy/SOC-Middleware-WebSG-Policy"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:TagPolicy"
      ],
      "Resource": "arn:aws:iam::908157891283:policy/SOC-Middleware-WebSG-Policy",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "soc-automation"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "Null": {
          "aws:RequestTag/Project": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion"
      ],
      "Resource": "arn:aws:iam::908157891283:policy/SOC-Middleware-WebSG-Policy",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "soc-automation"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:ListInstanceProfileTags"
      ],
      "Resource": "arn:aws:iam::908157891283:instance-profile/SOC-Middleware-Role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:TagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::908157891283:instance-profile/SOC-Middleware-Role",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "soc-automation"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "Null": {
          "aws:RequestTag/Project": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:AddRoleToInstanceProfile",
      "Resource": "arn:aws:iam::908157891283:instance-profile/SOC-Middleware-Role",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "soc-automation"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::908157891283:role/SOC-Middleware-Role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
