{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeVpcPeeringConnections",
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateVpc",
      "Resource": "arn:aws:ec2:ap-southeast-1:908157891283:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "soc-automation"
        },
        "StringLike": {
          "aws:RequestTag/Name": "soc-automation-*"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Name",
            "Project"
          ]
        },
        "Null": {
          "aws:RequestTag/Project": "false",
          "aws:RequestTag/Name": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateVpcPeeringConnection",
        "ec2:AttachInternetGateway",
        "ec2:AcceptVpcPeeringConnection",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:908157891283:vpc/vpc-01d5230934a140846",
        "arn:aws:ec2:ap-southeast-1:908157891283:vpc/vpc-0fb2381154ad1b418"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateInternetGateway",
        "ec2:CreateVpcPeeringConnection",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:908157891283:subnet/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:route-table/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:internet-gateway/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:vpc-peering-connection/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "soc-automation"
        },
        "StringLike": {
          "aws:RequestTag/Name": "soc-automation-*"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Name",
            "Project"
          ]
        },
        "Null": {
          "aws:RequestTag/Project": "false",
          "aws:RequestTag/Name": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifySubnetAttribute",
        "ec2:AttachInternetGateway",
        "ec2:AssociateRouteTable",
        "ec2:CreateRoute",
        "ec2:AcceptVpcPeeringConnection",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:908157891283:subnet/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:internet-gateway/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:route-table/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:vpc-peering-connection/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "ec2:ResourceTag/Project": "soc-automation"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:908157891283:vpc/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:subnet/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:route-table/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:internet-gateway/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:vpc-peering-connection/*",
        "arn:aws:ec2:ap-southeast-1:908157891283:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "soc-automation",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateRouteTable",
            "CreateInternetGateway",
            "CreateVpcPeeringConnection",
            "CreateSecurityGroup"
          ]
        },
        "StringLike": {
          "aws:RequestTag/Name": "soc-automation-*"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Name",
            "Project"
          ]
        },
        "Null": {
          "aws:RequestTag/Project": "false",
          "aws:RequestTag/Name": "false"
        }
      }
    }
  ]
}
