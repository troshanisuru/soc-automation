<!-- 
  wazuh/config/wazuh_ossec_oci.xml
  Wazuh Oracle Cloud Infrastructure (OCI) Object Storage & Agent Integration Configuration
  Append or merge this block into /var/ossec/etc/ossec.conf on the Wazuh Manager instance.
  Uses OCI Object Storage's S3-compatible endpoint or native log ingestion for OCI VCN Flow Logs & WAF logs.
-->

<ossec_config>

  <!-- OCI VCN Flow Logs Ingestion from OCI Object Storage (S3-Compatible API) -->
  <wodle name="aws-s3">
    <disabled>no</disabled>
    <interval>10m</interval>
    <run_on_start>yes</run_on_start>
    <skip_on_error>yes</skip_on_error>
    <bucket type="custom">
      <name>oci-waf-vcn-logs-soc-project</name>
      <path>vcn-flow-logs/</path>
      <!-- OCI Customer Secret Key (S3-compatible access/secret key) -->
      <access_key>YOUR_OCI_CUSTOMER_SECRET_ACCESS_KEY_ID</access_key>
      <secret_key>YOUR_OCI_CUSTOMER_SECRET_KEY</secret_key>
      <region>ap-singapore-1</region>
      <endpoint>https://YOUR_TENANCY_NAMESPACE.compat.objectstorage.ap-singapore-1.oraclecloud.com</endpoint>
    </bucket>
  </wodle>

  <!-- OCI WAF Logs Ingestion from OCI Object Storage (S3-Compatible API) -->
  <wodle name="aws-s3">
    <disabled>no</disabled>
    <interval>10m</interval>
    <run_on_start>yes</run_on_start>
    <skip_on_error>yes</skip_on_error>
    <bucket type="custom">
      <name>oci-waf-vcn-logs-soc-project</name>
      <path>waf-logs/</path>
      <access_key>YOUR_OCI_CUSTOMER_SECRET_ACCESS_KEY_ID</access_key>
      <secret_key>YOUR_OCI_CUSTOMER_SECRET_KEY</secret_key>
      <region>ap-singapore-1</region>
      <endpoint>https://YOUR_TENANCY_NAMESPACE.compat.objectstorage.ap-singapore-1.oraclecloud.com</endpoint>
    </bucket>
  </wodle>

</ossec_config>
